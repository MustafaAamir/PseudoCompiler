{
  "name": "@pseudo/web",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "check": "deno check src/ ui/ scripts/ tests/",
    "test": "deno test --allow-read=../examples",
    "build": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net scripts/build.ts",
    "dev": "deno task build && deno run --allow-read=dist --allow-net scripts/serve.ts",
    "run": "deno run --allow-read --allow-env=PSEUDO_SEED,NO_COLOR src/cli.ts"
  },
  "imports": {
    "effect": "npm:effect@^3.19.0",
    "rxjs": "npm:rxjs@^7.8.2",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-slow-types"
      ]
    }
  },
  "exclude": [
    "dist/"
  ]
}
