// Records, enumerations, pointers, dates and files.
TYPE Season = (Spring, Summer, Autumn, Winter)
TYPE IntPointer = ^INTEGER

TYPE Student
    DECLARE Name : STRING
    DECLARE Marks : ARRAY[1:3] OF INTEGER
    DECLARE Born : DATE
ENDTYPE

DECLARE Class : ARRAY[1:2] OF Student
DECLARE Copy : Student
DECLARE Now : Season
DECLARE P : IntPointer
DECLARE Value : INTEGER

Class[1].Name ← "Ada"
Class[1].Marks[1] ← 90
Class[1].Marks[2] ← 85
Class[1].Marks[3] ← 99
Class[1].Born ← 10/12/2008

Copy ← Class[1]          // records are copied on assignment
Copy.Name ← "Grace"
OUTPUT Class[1].Name, " / ", Copy.Name
OUTPUT "Born in ", YEAR(Class[1].Born), " (day index ", DAYINDEX(Class[1].Born), ")"

Now ← Autumn
IF Now > Summer THEN
    OUTPUT "It is ", Now
ENDIF

Value ← 41
P ← ^Value
P^ ← P^ + 1
OUTPUT "Through the pointer: ", Value

PROCEDURE Increment(BYREF Target : INTEGER)
    Target ← Target + 1
ENDPROCEDURE
CALL Increment(Class[1].Marks[2])
OUTPUT "Marks: ", Class[1].Marks

OPENFILE "records_demo.txt" FOR WRITE
FOR K ← 1 TO 3
    WRITEFILE "records_demo.txt", "line " & NUM_TO_STR(K)
NEXT K
CLOSEFILE "records_demo.txt"

DECLARE Line : STRING
OPENFILE "records_demo.txt" FOR READ
WHILE NOT EOF("records_demo.txt")
    READFILE "records_demo.txt", Line
    OUTPUT "read: ", Line
ENDWHILE
CLOSEFILE "records_demo.txt"

DECLARE Age : INTEGER
OUTPUT "Age?"
INPUT Age
OUTPUT "Next year you will be ", Age + 1
