// Polymorphism through message sends with inline caches.
CLASS Shape
    PRIVATE Label : STRING
    PUBLIC PROCEDURE NEW(GivenLabel : STRING)
        Label ← GivenLabel
    ENDPROCEDURE
    PUBLIC FUNCTION Area() RETURNS REAL
        RETURN 0.0
    ENDFUNCTION
    PUBLIC FUNCTION Describe() RETURNS STRING
        RETURN Label & " with area " & NUM_TO_STR(Area())
    ENDFUNCTION
ENDCLASS

CLASS Rectangle INHERITS Shape
    PRIVATE Width, Height : REAL
    PUBLIC PROCEDURE NEW(W : REAL, H : REAL)
        SUPER.NEW("rectangle")
        Width ← W
        Height ← H
    ENDPROCEDURE
    PUBLIC FUNCTION Area() RETURNS REAL
        RETURN Width * Height
    ENDFUNCTION
ENDCLASS

CLASS Circle INHERITS Shape
    PRIVATE Radius : REAL
    PUBLIC PROCEDURE NEW(R : REAL)
        SUPER.NEW("circle")
        Radius ← R
    ENDPROCEDURE
    PUBLIC FUNCTION Area() RETURNS REAL
        RETURN ROUND(3.14159 * Radius * Radius, 2)
    ENDFUNCTION
ENDCLASS

DECLARE Shapes : ARRAY[1:3] OF Shape
Shapes[1] ← NEW Rectangle(3, 4)
Shapes[2] ← NEW Circle(1)
Shapes[3] ← NEW Shape("point")

DECLARE Total : REAL
Total ← 0
FOR I ← 1 TO 3
    OUTPUT Shapes[I].Describe()
    Total ← Total + Shapes[I].Area()
NEXT I
OUTPUT "Total area: ", Total
OUTPUT "Largest: ", Largest(Shapes).Describe()

// Defined after its first use: checked when the file is complete.
FUNCTION Largest(Items : ARRAY[1:3] OF Shape) RETURNS Shape
    DECLARE Best : Shape
    Best ← Items[1]
    FOR J ← 2 TO 3
        IF Items[J].Area() > Best.Area() THEN
            Best ← Items[J]
        ENDIF
    NEXT J
    RETURN Best
ENDFUNCTION
